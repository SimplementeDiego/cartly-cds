# Docker Compose ports
FRONTEND_PORT=5173
BACKEND_PORT=3000
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# PostgreSQL (development-only defaults; change them outside local development)
POSTGRES_DB=cartly
POSTGRES_USER=cartly
POSTGRES_PASSWORD=cartly_dev_password
# Used when running the backend directly on the host. Compose overrides the host.
DATABASE_URL=postgresql://cartly:cartly_dev_password@localhost:5432/cartly?schema=public

# Authentication
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# Browser-facing frontend URL / CORS origin
FRONTEND_URL=http://localhost:5173

# Product image storage
MINIO_ROOT_USER=cartly_minio
MINIO_ROOT_PASSWORD=cartly_minio_password
MINIO_BUCKET=cartly-products
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=cartly_minio
MINIO_SECRET_KEY=cartly_minio_password
MINIO_USE_SSL=false
MINIO_REGION=us-east-1
MAX_IMAGE_SIZE_BYTES=5242880

# Stripe Checkout test mode. Never commit real keys.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_SUCCESS_URL=http://localhost:5173/checkout/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:5173/cart?checkout=cancelled
# Cartly currently supports USD (amounts are stored as integer cents).
CURRENCY=usd

# Frontend build-time configuration
VITE_API_URL=/api
# Reference display rate. The backend, orders and Stripe continue to use USD.
VITE_USD_UYU_RATE=42

# Playwright
E2E_BASE_URL=http://127.0.0.1:5173
# Leave empty to derive the local E2E connection from POSTGRES_* (including the published port).
# Override only for a dedicated test app: this must be the SAME database that app uses.
E2E_DATABASE_URL=
E2E_CUSTOMER_EMAIL=customer@cartly.local
E2E_CUSTOMER_PASSWORD=Customer123!
E2E_ADMIN_EMAIL=admin@cartly.local
E2E_ADMIN_PASSWORD=Admin123!
# Set to true only when valid Stripe test credentials are configured.
E2E_STRIPE_ENABLED=false
